embedded_error.log
engine_error.log

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/

# Playwright 浏览器
.playwright-browsers/

# 打包产物
build/
dist/

# 编辑器与系统
.vscode/
.idea/
.DS_Store
Thumbs.db

